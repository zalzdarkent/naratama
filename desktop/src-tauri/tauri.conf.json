{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naratama Gelanggang",
  "version": "0.1.0",
  "identifier": "id.naratama.gelanggang",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Naratama Gelanggang — Football Manager",
        "width": 1360,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}

